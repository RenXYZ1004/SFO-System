GMAIL_USER=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
MAIL_FROM_NAME=Registration Desk
ADMIN_COPY=
APP_NAME=Southville Run For A Cause 2026

# Injected automatically by Vercel once a Blob store is connected.
# For local dev, copy it from: Vercel > Storage > your store > .env.local tab
BLOB_READ_WRITE_TOKEN=

# public | private — how proof-of-payment receipts are stored.
#
# SET THIS TO private FOR THE REAL EVENT, and connect a private Blob store.
# Receipts are deposit slips: names, account numbers, amounts. On a public
# store every one of them gets a permanent internet URL that needs no sign-in
# — unguessable, but it never expires and it is written into the Google Sheet,
# so anyone who sees the Sheet can fetch the image forever.
#
# On a private store the same upload is only readable through /api/receipt,
# which is behind the staff passcode. Left unset, uploads default to public.
BLOB_ACCESS=

# --- staff dashboard --------------------------------------------------
# The dashboard shows contact numbers, emergency contacts and receipts, so it
# is unreachable until STAFF_PASSWORD is set. There is no default.
STAFF_PASSWORD=
# Signs the session cookie. Optional — derived from the password if unset, but
# set it to something random so changing the password does not sign everyone
# out, and so the cookie key is not a function of the passcode.
STAFF_SECRET=

# Canonical https origin, used to build receipt links in staff emails.
# Falls back to the Vercel-provided URL when unset.
SITE_URL=

# Postgres — from Vercel > Storage > Neon > .env.local tab
DATABASE_URL=

# Google Sheet mirror — the id from docs.google.com/spreadsheets/d/<ID>/edit
SHEET_ID=
SHEET_TAB=Registrations
