GMAIL_USER=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
MAIL_FROM_NAME=Registration Desk
ADMIN_COPY=
APP_NAME=Southville Run For A Cause 2026

# Injected automatically by Vercel once a Blob store is connected.
# For local dev, copy it from: Vercel > Storage > your store > .env.local tab
BLOB_READ_WRITE_TOKEN=

# Postgres — from Vercel > Storage > Neon > .env.local tab
DATABASE_URL=

# Google Sheet mirror — the id from docs.google.com/spreadsheets/d/<ID>/edit
SHEET_ID=
SHEET_TAB=Registrations

# --- Staff dashboard (/staff) ---------------------------------------------
# Anyone with this passcode can see every runner s personal details.
# Leave blank to keep the dashboard switched off entirely.
STAFF_PASSWORD=
STAFF_SECRET=

# Public address of the deployed site
SITE_URL=https://sfo-system.vercel.app
