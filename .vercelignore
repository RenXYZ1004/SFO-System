# What never leaves this machine.
#
# IMPORTANT: once this file exists, the Vercel CLI uses it INSTEAD of
# .gitignore when deciding what to upload. Everything secret therefore has to
# be named here as well, even though .gitignore already covers it — dropping a
# line from this file is enough to start shipping it.

# --- secrets -----------------------------------------------------------
.env
.env.*
*.pem
*.key
token-run.log
*.log

# --- never needed at runtime -------------------------------------------
# The functions in api/ import from lib/ only; nothing imports tools/, and
# there is no build step to run them. assets-src/ is working files and the
# maintainer notes that used to sit in the web root.
tools/
assets-src/

# Supplier artwork kept for reference. The measurements off the two size
# charts live in lib/form-schema.js and the page draws the chart itself, so
# nothing serves these — they are 2 MB of upload that no visitor can reach.
reference_shirt.png
Kidz_shirt_size.png
image.png
Unisex_size.png

node_modules
.git
.github
.vercel

# --- repo furniture ----------------------------------------------------
README.md
.gitignore
.vercelignore
